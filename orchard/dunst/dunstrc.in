# Orchard — уведомления в стиле macOS (справа сверху). Цвета подставляет orchard-ctl.
[global]
    origin = top-right
    offset = 12x36
    width = 340
    notification_limit = 4
    padding = 12
    horizontal_padding = 14
    frame_width = 1
    frame_color = "@@BORDER@@"
    corner_radius = 12
    separator_height = 0
    gap_size = 8
    font = Inter 10
    markup = full
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 40
    show_age_threshold = 60
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all
[urgency_low]
    background = "@@BG@@"
    foreground = "@@FG@@"
    timeout = 5
[urgency_normal]
    background = "@@BG@@"
    foreground = "@@FG@@"
    timeout = 7
[urgency_critical]
    background = "@@BG@@"
    foreground = "@@FG@@"
    frame_color = "#FF453A"
    timeout = 0
