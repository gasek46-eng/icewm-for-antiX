# Orchard-Dark — оконная тема IceWM в стиле macOS (тёмная)
# Часть набора Orchard: https://github.com/gasek46-eng/icewm-for-antix
ThemeDescription="Orchard-Dark"
ThemeAuthor="Orchard for antiX"

Look=flat

# --- Заголовок окна ---
TitleBarHeight=28
TitleBarJustify=50
TitleBarCentered=1
TitleBarHorzOffset=0
TitleBarVertOffset=0
TitleButtonsLeft="xim"
TitleButtonsRight=""
TitleButtonsSupported="xim"
RolloverButtonsSupported=1
ShowMenuButtonIcon=0

BorderSizeX=1
BorderSizeY=1
DlgBorderSizeX=1
DlgBorderSizeY=1
CornerSizeX=14
CornerSizeY=14

ColorActiveTitleBar="rgb:3A/3A/3D"
ColorNormalTitleBar="rgb:2B/2B/2E"
ColorActiveTitleBarText="rgb:E6/E6/E8"
ColorNormalTitleBarText="rgb:8C/8C/91"
ColorActiveTitleBarShadow=""
ColorNormalTitleBarShadow=""
ColorActiveBorder="rgb:12/12/14"
ColorNormalBorder="rgb:1C/1C/1E"
TitleFontNameXft="Inter:size=10:weight=600,sans-serif:size=10:bold"

# --- Меню ---
MenuFontNameXft="Inter:size=10,sans-serif:size=10"
ColorNormalMenu="rgb:2C/2C/2F"
ColorNormalMenuItemText="rgb:EC/EC/EE"
ColorActiveMenuItem="rgb:0A/84/FF"
ColorActiveMenuItemText="rgb:FF/FF/FF"
ColorDisabledMenuItemText="rgb:6E/6E/73"
ColorDisabledMenuItemShadow=""
ColorNormalMenuSeparator="rgb:3E/3E/42"
ColorActiveMenuSeparator="rgb:3E/3E/42"
MenuIconSize=16

# --- Верхняя панель (строка меню) ---
ColorDefaultTaskBar="rgb:25/25/28"
ColorNormalButton="rgb:25/25/28"
ColorActiveButton="rgb:3C/3C/40"
ColorNormalButtonText="rgb:F2/F2/F4"
ColorActiveButtonText="rgb:F2/F2/F4"
ColorToolButton="rgb:25/25/28"
ColorToolButtonText="rgb:F2/F2/F4"
ColorNormalTaskBarApp="rgb:25/25/28"
ColorNormalTaskBarAppText="rgb:F2/F2/F4"
ColorActiveTaskBarApp="rgb:3C/3C/40"
ColorActiveTaskBarAppText="rgb:F2/F2/F4"
ColorMinimizedTaskBarApp="rgb:25/25/28"
ColorMinimizedTaskBarAppText="rgb:6E/6E/73"
ColorNormalWorkspaceButton="rgb:25/25/28"
ColorNormalWorkspaceButtonText="rgb:F2/F2/F4"
ColorActiveWorkspaceButton="rgb:3C/3C/40"
ColorActiveWorkspaceButtonText="rgb:F2/F2/F4"
ColorClock="rgb:25/25/28"
ColorClockText="rgb:F2/F2/F4"
ColorApm="rgb:25/25/28"
ColorApmText="rgb:F2/F2/F4"
ColorApmBattery="rgb:F2/F2/F4"
ColorApmLine="rgb:F2/F2/F4"
ColorApmGraphBg="rgb:25/25/28"
ColorKeyboardLayoutText="rgb:F2/F2/F4"
TaskBarClockLeds=0
NormalButtonFontNameXft="Inter:size=10,sans-serif:size=10"
ActiveButtonFontNameXft="Inter:size=10,sans-serif:size=10"
ToolButtonFontNameXft="Inter:size=10,sans-serif:size=10"
NormalTaskBarFontNameXft="Inter:size=10,sans-serif:size=10"
ActiveTaskBarFontNameXft="Inter:size=10,sans-serif:size=10"
ClockFontNameXft="Inter:size=10:weight=500,sans-serif:size=10"
ApmFontNameXft="Inter:size=10,sans-serif:size=10"
NormalWorkspaceFontNameXft="Inter:size=10,sans-serif:size=10"
ActiveWorkspaceFontNameXft="Inter:size=10:weight=600,sans-serif:size=10:bold"

# --- Переключатель окон Alt+Tab, диалоги, подсказки ---
ColorQuickSwitch="rgb:2C/2C/2F"
ColorQuickSwitchText="rgb:EC/EC/EE"
ColorQuickSwitchActive="rgb:0A/84/FF"
QuickSwitchFontNameXft="Inter:size=11,sans-serif:size=11"
ColorDialog="rgb:2A/2A/2D"
ColorToolTip="rgb:2C/2C/2F"
ColorToolTipText="rgb:EC/EC/EE"
ToolTipFontNameXft="Inter:size=9,sans-serif:size=9"
ColorListBox="rgb:1E/1E/20"
ColorListBoxText="rgb:EC/EC/EE"
ColorListBoxSelection="rgb:0A/84/FF"
ColorListBoxSelectionText="rgb:FF/FF/FF"
ColorScrollBar="rgb:2A/2A/2D"
ColorScrollBarSlider="rgb:6E/6E/73"
ColorScrollBarButton="rgb:2A/2A/2D"
ColorInput="rgb:1E/1E/20"
ColorInputText="rgb:EC/EC/EE"
ColorInputSelection="rgb:0A/84/FF"
ColorInputSelectionText="rgb:FF/FF/FF"
ColorMoveSizeStatus="rgb:2C/2C/2F"
ColorMoveSizeStatusText="rgb:EC/EC/EE"
StatusFontNameXft="Inter:size=10,sans-serif:size=10"
