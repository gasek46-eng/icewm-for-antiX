# Orchard — оконная тема IceWM в стиле macOS (светлая)
# Часть набора Orchard: https://github.com/gasek46-eng/icewm-for-antix
ThemeDescription="Orchard"
ThemeAuthor="Orchard for antiX"

Look=flat

# --- Заголовок окна ---
TitleBarHeight=28
TitleBarJustify=50
TitleBarCentered=1
TitleBarHorzOffset=0
TitleBarVertOffset=0
TitleButtonsLeft="xim"
TitleButtonsRight=""
TitleButtonsSupported="xim"
RolloverButtonsSupported=1
ShowMenuButtonIcon=0

BorderSizeX=1
BorderSizeY=1
DlgBorderSizeX=1
DlgBorderSizeY=1
CornerSizeX=14
CornerSizeY=14

ColorActiveTitleBar="rgb:E9/E9/EB"
ColorNormalTitleBar="rgb:F6/F6/F7"
ColorActiveTitleBarText="rgb:3A/3A/3C"
ColorNormalTitleBarText="rgb:A9/A9/AD"
ColorActiveTitleBarShadow=""
ColorNormalTitleBarShadow=""
ColorActiveBorder="rgb:C6/C6/CA"
ColorNormalBorder="rgb:DA/DA/DE"
TitleFontNameXft="Inter:size=10:weight=600,sans-serif:size=10:bold"

# --- Меню ---
MenuFontNameXft="Inter:size=10,sans-serif:size=10"
ColorNormalMenu="rgb:F6/F6/F8"
ColorNormalMenuItemText="rgb:1D/1D/1F"
ColorActiveMenuItem="rgb:00/7A/FF"
ColorActiveMenuItemText="rgb:FF/FF/FF"
ColorDisabledMenuItemText="rgb:B0/B0/B5"
ColorDisabledMenuItemShadow=""
ColorNormalMenuSeparator="rgb:DC/DC/E0"
ColorActiveMenuSeparator="rgb:DC/DC/E0"
MenuIconSize=16

# --- Верхняя панель (строка меню) ---
ColorDefaultTaskBar="rgb:F3/F3/F5"
ColorNormalButton="rgb:F3/F3/F5"
ColorActiveButton="rgb:DC/DC/E0"
ColorNormalButtonText="rgb:1D/1D/1F"
ColorActiveButtonText="rgb:1D/1D/1F"
ColorToolButton="rgb:F3/F3/F5"
ColorToolButtonText="rgb:1D/1D/1F"
ColorNormalTaskBarApp="rgb:F3/F3/F5"
ColorNormalTaskBarAppText="rgb:1D/1D/1F"
ColorActiveTaskBarApp="rgb:DC/DC/E0"
ColorActiveTaskBarAppText="rgb:1D/1D/1F"
ColorMinimizedTaskBarApp="rgb:F3/F3/F5"
ColorMinimizedTaskBarAppText="rgb:B0/B0/B5"
ColorNormalWorkspaceButton="rgb:F3/F3/F5"
ColorNormalWorkspaceButtonText="rgb:1D/1D/1F"
ColorActiveWorkspaceButton="rgb:DC/DC/E0"
ColorActiveWorkspaceButtonText="rgb:1D/1D/1F"
ColorClock="rgb:F3/F3/F5"
ColorClockText="rgb:1D/1D/1F"
ColorApm="rgb:F3/F3/F5"
ColorApmText="rgb:1D/1D/1F"
ColorApmBattery="rgb:1D/1D/1F"
ColorApmLine="rgb:1D/1D/1F"
ColorApmGraphBg="rgb:F3/F3/F5"
ColorKeyboardLayoutText="rgb:1D/1D/1F"
TaskBarClockLeds=0
NormalButtonFontNameXft="Inter:size=10,sans-serif:size=10"
ActiveButtonFontNameXft="Inter:size=10,sans-serif:size=10"
ToolButtonFontNameXft="Inter:size=10,sans-serif:size=10"
NormalTaskBarFontNameXft="Inter:size=10,sans-serif:size=10"
ActiveTaskBarFontNameXft="Inter:size=10,sans-serif:size=10"
ClockFontNameXft="Inter:size=10:weight=500,sans-serif:size=10"
ApmFontNameXft="Inter:size=10,sans-serif:size=10"
NormalWorkspaceFontNameXft="Inter:size=10,sans-serif:size=10"
ActiveWorkspaceFontNameXft="Inter:size=10:weight=600,sans-serif:size=10:bold"

# --- Переключатель окон Alt+Tab, диалоги, подсказки ---
ColorQuickSwitch="rgb:F6/F6/F8"
ColorQuickSwitchText="rgb:1D/1D/1F"
ColorQuickSwitchActive="rgb:00/7A/FF"
QuickSwitchFontNameXft="Inter:size=11,sans-serif:size=11"
ColorDialog="rgb:F2/F2/F4"
ColorToolTip="rgb:F6/F6/F8"
ColorToolTipText="rgb:1D/1D/1F"
ToolTipFontNameXft="Inter:size=9,sans-serif:size=9"
ColorListBox="rgb:FF/FF/FF"
ColorListBoxText="rgb:1D/1D/1F"
ColorListBoxSelection="rgb:00/7A/FF"
ColorListBoxSelectionText="rgb:FF/FF/FF"
ColorScrollBar="rgb:F2/F2/F4"
ColorScrollBarSlider="rgb:B0/B0/B5"
ColorScrollBarButton="rgb:F2/F2/F4"
ColorInput="rgb:FF/FF/FF"
ColorInputText="rgb:1D/1D/1F"
ColorInputSelection="rgb:00/7A/FF"
ColorInputSelectionText="rgb:FF/FF/FF"
ColorMoveSizeStatus="rgb:F6/F6/F8"
ColorMoveSizeStatusText="rgb:1D/1D/1F"
StatusFontNameXft="Inter:size=10,sans-serif:size=10"
